from __future__ import annotations

import argparse
import gzip
import hashlib
import hmac
import json
import os
import re
import secrets
import shutil
import socket
import socketserver
import sqlite3
import subprocess
import sys
import threading
import urllib.parse
from datetime import datetime, timedelta, timezone
from http import HTTPStatus
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

APP = "gotrain"
DATA_DIR = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / APP
CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / APP
DB_PATH = DATA_DIR / "gotrain.db"
SNAPSHOT_DIR = DATA_DIR / "snapshots"
CONFIG_PATH = CONFIG_DIR / "config.json"

WIDGET_IPC_TARGET = "nicklyk.gotrain"

DEFAULT_CONFIG = {
    # Where `gotrain sync` looks for exports dropped by LocalSend or a browser.
    "watchDirs": ["~/Downloads"],
    "watchGlobs": [
        "*export*.json",
        "gotrain*.json",
        "trainingsplan*.json",
        "workout_plan*.json",
    ],
    "port": 8765,
    # Ceiling on the base64url payload a phone may put in a `GET /recv` URL.
    # http.server hardcodes a 65536-byte request line, so stay clear of it.
    "maxUrlPayload": 50000,
    "pairTimeout": 300,
    "staleDays": 3,
    "origin": "https://niclick.org",
    "appUrl": "https://niclick.org/GoTrain",
}

SCHEMA = """
CREATE TABLE IF NOT EXISTS meta (
  key   TEXT PRIMARY KEY,
  value TEXT
);

CREATE TABLE IF NOT EXISTS snapshots (
  id            INTEGER PRIMARY KEY AUTOINCREMENT,
  sha256        TEXT NOT NULL UNIQUE,
  imported_at   TEXT NOT NULL,
  source        TEXT NOT NULL,
  path          TEXT,
  kind          TEXT NOT NULL,
  workouts_seen INTEGER NOT NULL DEFAULT 0,
  workouts_new  INTEGER NOT NULL DEFAULT 0
);

-- `json` holds the entry verbatim (minus `exercises`) so `gotrain export` can
-- round-trip losslessly. The broken-out columns exist for querying.
CREATE TABLE IF NOT EXISTS workouts (
  id              TEXT PRIMARY KEY,
  ts              TEXT,
  ts_source       TEXT NOT NULL DEFAULT 'none',
  raw_date        TEXT,
  raw_time        TEXT,
  plan            TEXT,
  plan_id         TEXT,
  total_exercises INTEGER,
  done_exercises  INTEGER,
  total_sets      INTEGER,
  json            TEXT NOT NULL DEFAULT '{}',
  first_seen      TEXT NOT NULL,
  snapshot_id     INTEGER REFERENCES snapshots(id)
);
CREATE INDEX IF NOT EXISTS idx_workouts_ts ON workouts(ts);

-- reps/duration_min/kg are TEXT on purpose: GoTrain stores them as strings
-- ('8-12', '5', ''), and coercing them to numbers would lose the ranges.
CREATE TABLE IF NOT EXISTS workout_exercises (
  workout_id     TEXT NOT NULL REFERENCES workouts(id) ON DELETE CASCADE,
  idx            INTEGER NOT NULL,
  ex_id          TEXT,
  icon           TEXT,
  name           TEXT,
  muscle         TEXT,
  type           TEXT,
  sets           INTEGER,
  reps           TEXT,
  duration_min   TEXT,
  kg             TEXT,
  sets_completed INTEGER,
  done           INTEGER,
  json           TEXT NOT NULL DEFAULT '{}',
  PRIMARY KEY (workout_id, idx)
);

CREATE TABLE IF NOT EXISTS plans (
  id         TEXT PRIMARY KEY,
  name       TEXT,
  json       TEXT NOT NULL,
  updated_at TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS exercises (
  id         TEXT PRIMARY KEY,
  name       TEXT,
  muscle     TEXT,
  json       TEXT NOT NULL,
  updated_at TEXT NOT NULL
);
"""


# ─────────────────────────────────────────────────────────────────────────────
# helpers
# ─────────────────────────────────────────────────────────────────────────────

def now_iso() -> str:
    return datetime.now(timezone.utc).astimezone().isoformat(timespec="seconds")


def die(msg: str, code: int = 1):
    print(f"{APP}: {msg}", file=sys.stderr)
    # Launched from the bar panel there is no terminal to read stderr in, so
    # the failure has to surface as a notification or it is simply invisible.
    if not sys.stderr.isatty():
        notify("GoTrain", msg.splitlines()[0])
    raise SystemExit(code)


def load_config() -> dict:
    cfg = dict(DEFAULT_CONFIG)
    if CONFIG_PATH.exists():
        try:
            cfg.update(json.loads(CONFIG_PATH.read_text()))
        except (OSError, json.JSONDecodeError) as e:
            print(f"{APP}: ignoring bad config {CONFIG_PATH}: {e}", file=sys.stderr)
    return cfg


def connect() -> sqlite3.Connection:
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    SNAPSHOT_DIR.mkdir(parents=True, exist_ok=True)
    db = sqlite3.connect(DB_PATH)
    db.row_factory = sqlite3.Row
    db.execute("PRAGMA foreign_keys = ON")
    db.executescript(SCHEMA)
    return db


def meta_get(db, key, default=None):
    row = db.execute("SELECT value FROM meta WHERE key = ?", (key,)).fetchone()
    return row["value"] if row else default


def meta_set(db, key, value):
    db.execute(
        "INSERT INTO meta (key, value) VALUES (?, ?) "
        "ON CONFLICT(key) DO UPDATE SET value = excluded.value",
        (key, value),
    )


def have(cmd: str) -> bool:
    return shutil.which(cmd) is not None


def notify(headline: str, body: str = ""):
    if not have("omarchy-notification-send"):
        return
    args = ["omarchy-notification-send", "-g", "\U000f115d", headline]  # nf-md-weight-lifter
    if body:
        args.append(body)
    subprocess.run(args, check=False, capture_output=True)


def poke_widget():
    """Ask the bar widget to re-read the DB. Best effort; the shell may be down."""
    if not have("omarchy-shell"):
        return
    subprocess.run(
        ["omarchy-shell", WIDGET_IPC_TARGET, "refresh"],
        check=False, capture_output=True, timeout=5,
    )


# ─────────────────────────────────────────────────────────────────────────────
# timestamps
#
# GoTrain historically stored only localized display strings. Newer entries
# carry an ISO `ts`; older ones must be recovered from `date`/`time`, whose
# format depends on the app language at the time it was recorded.
# ─────────────────────────────────────────────────────────────────────────────

_DE_DATE = re.compile(r"^(\d{1,2})\.(\d{1,2})\.(\d{4})$")
_US_DATE = re.compile(r"^(\d{1,2})/(\d{1,2})/(\d{4})$")
_ISO_DATE = re.compile(r"^(\d{4})-(\d{2})-(\d{2})$")


def parse_legacy_datetime(date_s, time_s):
    """Return (iso_string, 'locale') or (None, 'none')."""
    if not date_s or not isinstance(date_s, str):
        return None, "none"
    d = date_s.strip()

    ymd = None
    if m := _DE_DATE.match(d):                      # 14.4.2026 -> d.m.Y
        ymd = (int(m.group(3)), int(m.group(2)), int(m.group(1)))
    elif m := _US_DATE.match(d):                    # 4/14/2026 -> m/d/Y
        ymd = (int(m.group(3)), int(m.group(1)), int(m.group(2)))
    elif m := _ISO_DATE.match(d):
        ymd = (int(m.group(1)), int(m.group(2)), int(m.group(3)))
    if not ymd:
        return None, "none"

    hh, mm = 0, 0
    if isinstance(time_s, str) and time_s.strip():
        t = time_s.strip().upper()
        pm = t.endswith("PM")
        am = t.endswith("AM")
        t = t.replace("AM", "").replace("PM", "").strip()
        if m := re.match(r"^(\d{1,2}):(\d{2})", t):
            hh, mm = int(m.group(1)), int(m.group(2))
            if pm and hh < 12:
                hh += 12
            if am and hh == 12:
                hh = 0

    try:
        dt = datetime(ymd[0], ymd[1], ymd[2], hh, mm)
    except ValueError:
        return None, "none"
    return dt.astimezone().isoformat(timespec="seconds"), "locale"


def workout_timestamp(entry: dict):
    ts = entry.get("ts")
    if isinstance(ts, str) and ts.strip():
        try:
            datetime.fromisoformat(ts.replace("Z", "+00:00"))
            return ts, "iso"
        except ValueError:
            pass
    return parse_legacy_datetime(entry.get("date"), entry.get("time"))


def to_local(ts: str | None):
    if not ts:
        return None
    try:
        dt = datetime.fromisoformat(ts.replace("Z", "+00:00"))
    except ValueError:
        return None
    if dt.tzinfo is None:
        dt = dt.astimezone()
    return dt.astimezone()


# ─────────────────────────────────────────────────────────────────────────────
# ingest
# ─────────────────────────────────────────────────────────────────────────────

def _num(v):
    """Coerce to a number for counting columns; None when it isn't one."""
    if isinstance(v, bool):
        return int(v)
    if isinstance(v, (int, float)):
        return v
    if isinstance(v, str):
        try:
            return int(v.strip())
        except ValueError:
            return None
    return None


def _text(v):
    """Keep GoTrain's string-ish fields ('8-12', '', '5') exactly as given."""
    if v is None:
        return None
    if isinstance(v, bool):
        return "1" if v else "0"
    if isinstance(v, (int, float)):
        return str(v)
    return v if isinstance(v, str) else json.dumps(v, ensure_ascii=False)


def validate_state(state, kind: str):
    """Mirror what GoTrain's own importData() insists on."""
    if not isinstance(state, dict):
        raise ValueError("not a JSON object")
    if kind == "full":
        # Mirrors GoTrain's importData(): a plan library is required to be
        # present, but may legitimately be empty -- a fresh install ships no
        # preset plan, so `plans: []` with a null activePlanId is a valid
        # export rather than a malformed one.
        if not isinstance(state.get("plans"), list) or "activePlanId" not in state:
            raise ValueError(
                "missing 'plans'/'activePlanId' -- this does not look like a "
                "GoTrain export"
            )
    if "history" in state and not isinstance(state["history"], list):
        raise ValueError("'history' is not a list")


def plan_hash(state: dict) -> str:
    payload = json.dumps(
        {"plans": state.get("plans", []), "globalExercises": state.get("globalExercises", [])},
        sort_keys=True, separators=(",", ":"), ensure_ascii=False,
    )
    return hashlib.sha256(payload.encode()).hexdigest()[:16]


def ingest(db, state: dict, *, source: str, kind: str = "full", raw: bytes | None = None):
    """Merge one state blob. Returns a summary dict.

    Workouts are keyed by GoTrain's own history id and inserted with
    INSERT OR IGNORE, so a phone that prunes or resets its history can never
    remove what this machine already recorded.
    """
    validate_state(state, kind)

    if raw is None:
        raw = json.dumps(state, ensure_ascii=False).encode()
    digest = hashlib.sha256(raw).hexdigest()

    existing = db.execute("SELECT id FROM snapshots WHERE sha256 = ?", (digest,)).fetchone()
    if existing:
        return {"duplicate": True, "new": 0, "seen": 0,
                "snapshot_id": existing["id"], "prs": []}

    stamp = now_iso()
    snap_path = None
    if kind == "full":
        snap_path = SNAPSHOT_DIR / f"{stamp.replace(':', '')}-{digest[:8]}.json"
        snap_path.write_bytes(raw)

    cur = db.execute(
        "INSERT INTO snapshots (sha256, imported_at, source, path, kind) "
        "VALUES (?, ?, ?, ?, ?)",
        (digest, stamp, source, str(snap_path) if snap_path else None, kind),
    )
    snapshot_id = cur.lastrowid

    # A first import would otherwise crown every exercise a record and fire a
    # wall of noise, so only diff records when the archive already held data.
    had_data = db.execute("SELECT COUNT(*) c FROM workouts").fetchone()["c"] > 0
    before = best_loads(db) if had_data else {}

    history = state.get("history") or []
    seen = len(history)
    new = 0

    for entry in history:
        if not isinstance(entry, dict):
            continue
        wid = entry.get("id")
        if wid is None:
            continue
        wid = str(wid)
        ts, ts_source = workout_timestamp(entry)

        row = db.execute(
            "SELECT id, ts_source FROM workouts WHERE id = ?", (wid,)
        ).fetchone()

        if row:
            # Upgrade a locale-derived timestamp once a real ISO one arrives.
            if ts_source == "iso" and row["ts_source"] != "iso":
                db.execute(
                    "UPDATE workouts SET ts = ?, ts_source = ? WHERE id = ?",
                    (ts, ts_source, wid),
                )
            continue

        bare = {k: v for k, v in entry.items() if k != "exercises"}
        db.execute(
            "INSERT INTO workouts (id, ts, ts_source, raw_date, raw_time, plan, "
            "plan_id, total_exercises, done_exercises, total_sets, json, "
            "first_seen, snapshot_id) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?)",
            (
                wid, ts, ts_source,
                entry.get("date"), entry.get("time"),
                entry.get("plan"), entry.get("planId"),
                _num(entry.get("totalExercises")),
                _num(entry.get("doneExercises")),
                _num(entry.get("totalSets")),
                json.dumps(bare, ensure_ascii=False),
                stamp, snapshot_id,
            ),
        )
        new += 1

        for i, ex in enumerate(entry.get("exercises") or []):
            if not isinstance(ex, dict):
                continue
            db.execute(
                "INSERT OR REPLACE INTO workout_exercises (workout_id, idx, ex_id, "
                "icon, name, muscle, type, sets, reps, duration_min, kg, "
                "sets_completed, done, json) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?)",
                (
                    wid, i, ex.get("id"), ex.get("icon"), ex.get("name"),
                    ex.get("muscle"), ex.get("type"),
                    _num(ex.get("sets")), _text(ex.get("reps")),
                    _text(ex.get("durationMin")), _text(ex.get("kg")),
                    _num(ex.get("setsCompleted")),
                    1 if ex.get("done") else 0,
                    json.dumps(ex, ensure_ascii=False),
                ),
            )

    # The plan library is current-state, not history: replace it wholesale, but
    # only from a full export -- a delta carries no library at all.
    if kind == "full":
        db.execute("DELETE FROM plans")
        for p in state.get("plans") or []:
            if isinstance(p, dict) and p.get("id"):
                db.execute(
                    "INSERT OR REPLACE INTO plans (id, name, json, updated_at) VALUES (?,?,?,?)",
                    (str(p["id"]), p.get("name"),
                     json.dumps(p, ensure_ascii=False), stamp),
                )
        db.execute("DELETE FROM exercises")
        for e in state.get("globalExercises") or []:
            if isinstance(e, dict) and e.get("id"):
                db.execute(
                    "INSERT OR REPLACE INTO exercises (id, name, muscle, json, updated_at) "
                    "VALUES (?,?,?,?,?)",
                    (str(e["id"]), e.get("name"), e.get("muscle"),
                     json.dumps(e, ensure_ascii=False), stamp),
                )
        meta_set(db, "plan_hash", plan_hash(state))
        meta_set(db, "state_scalars", json.dumps({
            "globalPauseSecs": state.get("globalPauseSecs", 75),
            "lang": state.get("lang", "en"),
            "activePlanId": state.get("activePlanId"),
            "progress": state.get("progress", {}),
        }, ensure_ascii=False))

    db.execute(
        "UPDATE snapshots SET workouts_seen = ?, workouts_new = ? WHERE id = ?",
        (seen, new, snapshot_id),
    )
    refresh_cursor(db)
    db.commit()

    prs = []
    if had_data and new:
        for entry in records(db):
            previous = before.get(entry["name"])
            if previous is not None and entry["best"] > previous:
                prs.append({"name": entry["name"], "best": entry["best"],
                            "previous": previous, "unit": entry["unit"]})
        prs.sort(key=lambda r: -(r["best"] - r["previous"]))

    return {"duplicate": False, "new": new, "seen": seen,
            "snapshot_id": snapshot_id, "prs": prs}


def refresh_cursor(db):
    row = db.execute("SELECT MAX(ts) AS m FROM workouts WHERE ts IS NOT NULL").fetchone()
    meta_set(db, "cursor_ts", row["m"] or "")


def read_state_bytes(raw: bytes):
    """Accept gzip or plain JSON; return (state, canonical_raw_json_bytes)."""
    if raw[:2] == b"\x1f\x8b":
        raw = gzip.decompress(raw)
    text = raw.decode("utf-8-sig")
    return json.loads(text), raw


# ─────────────────────────────────────────────────────────────────────────────
# progression
#
# GoTrain copies the plan's `kg` (or `durationMin` for timed exercises) into
# every history entry, so the archive already holds a dated load series per
# exercise. Nothing here changes the schema.
# ─────────────────────────────────────────────────────────────────────────────

SPARK = "▁▂▃▄▅▆▇█"


# GoTrain stores muscle groups as language-independent keys since schema 2,
# but the archive still holds the German and English labels written before
# that. Normalise both to one key so a chart does not show "Rücken" and
# "back" as two separate groups, and render an English label for display.

MUSCLE_ALIASES = {
    "bauch": "abs", "abs": "abs",
    "rücken": "back", "ruecken": "back", "back": "back",
    "bizeps": "biceps", "biceps": "biceps",
    "waden": "calves", "calves": "calves",
    "cardio": "cardio",
    "brust": "chest", "chest": "chest",
    "unterarme": "forearms", "forearms": "forearms",
    "ganzkörper": "fullbody", "ganzkoerper": "fullbody",
    "full body": "fullbody", "fullbody": "fullbody",
    "allgemein": "general", "general": "general",
    "gesäß": "glutes", "gesaess": "glutes", "glutes": "glutes",
    "beine": "legs", "legs": "legs",
    "nacken": "neck", "neck": "neck",
    "schulter": "shoulders", "shoulders": "shoulders",
    "trizeps": "triceps", "triceps": "triceps",
}

MUSCLE_LABELS = {
    "abs": "Abs", "back": "Back", "biceps": "Biceps", "calves": "Calves",
    "cardio": "Cardio", "chest": "Chest", "forearms": "Forearms",
    "fullbody": "Full body", "general": "General", "glutes": "Glutes",
    "legs": "Legs", "neck": "Neck", "shoulders": "Shoulders",
    "triceps": "Triceps",
}


def muscle_key(value) -> str:
    text = str(value or "").strip()
    if not text:
        return ""
    return MUSCLE_ALIASES.get(text.lower(), text)


def muscle_label(value) -> str:
    key = muscle_key(value)
    return MUSCLE_LABELS.get(key, key)


def weight(v):
    """Parse GoTrain's load strings. '60', '60,5', '', None and '8-12' all occur."""
    if v is None:
        return None
    if isinstance(v, (int, float)) and not isinstance(v, bool):
        return float(v)
    text = str(v).strip().replace(",", ".")
    if not text:
        return None
    try:
        value = float(text)
    except ValueError:
        return None          # ranges like '8-12' are reps, never a load
    return value if value > 0 else None


def load_series(db, name=None):
    """{exercise: {muscle, unit, points: [(date, value)]}} oldest first."""
    sql = ("SELECT e.name, e.muscle, e.type, e.kg, e.duration_min, date(w.ts) d "
           "FROM workout_exercises e JOIN workouts w ON w.id = e.workout_id "
           "WHERE w.ts IS NOT NULL")
    args = []
    if name:
        sql += " AND lower(e.name) = lower(?)"
        args.append(name)
    sql += " ORDER BY w.ts"

    out = {}
    for r in db.execute(sql, args):
        timed = (r["type"] or "") == "time"
        value = weight(r["duration_min"] if timed else r["kg"])
        if value is None:
            continue
        entry = out.setdefault(r["name"] or "?", {
            "muscle": muscle_label(r["muscle"]), "unit": "min" if timed else "kg",
            "points": []})
        entry["points"].append((r["d"], value))
    return out


def progression(db, name=None):
    """Per exercise: first, current, best and the change between the ends."""
    rows = []
    for exercise, info in load_series(db, name).items():
        values = [v for _, v in info["points"]]
        if not values:
            continue
        best = max(values)
        rows.append({
            "name": exercise,
            "muscle": info["muscle"],
            "unit": info["unit"],
            "sessions": len(values),
            "first": values[0],
            "current": values[-1],
            "best": best,
            "change": values[-1] - values[0],
            "atBest": values[-1] >= best,
            "lastDate": info["points"][-1][0],
            "series": values,
            "dates": [d for d, _ in info["points"]],
        })
    # Gains first, regressions last, so a deload is never buried mid-list.
    rows.sort(key=lambda r: (-r["change"], r["name"]))
    return rows


def records(db):
    """Best ever per exercise, and the first date it was reached."""
    out = []
    for exercise, info in load_series(db).items():
        best = max(v for _, v in info["points"])
        when = next(d for d, v in info["points"] if v >= best)
        out.append({"name": exercise, "muscle": info["muscle"], "unit": info["unit"],
                    "best": best, "date": when})
    out.sort(key=lambda r: (-r["best"], r["name"]))
    return out


def best_loads(db) -> dict:
    """{exercise: best} — the cheap form used to diff records across an import."""
    return {r["name"]: r["best"] for r in records(db)}


def spark(values, width=24):
    if not values:
        return ""
    tail = values[-width:]
    lo, hi = min(tail), max(tail)
    if hi == lo:
        return SPARK[3] * len(tail)
    step = (hi - lo) / 7.0
    return "".join(SPARK[max(0, min(7, int((v - lo) / step)))] for v in tail)


def fmt_load(value, unit):
    return f"{value:g}{unit}"


# ─────────────────────────────────────────────────────────────────────────────
# reporting
# ─────────────────────────────────────────────────────────────────────────────

def compute_status(db, cfg) -> dict:
    total = db.execute("SELECT COUNT(*) AS c FROM workouts").fetchone()["c"]
    last = db.execute(
        "SELECT * FROM workouts WHERE ts IS NOT NULL ORDER BY ts DESC LIMIT 1"
    ).fetchone()

    out = {
        "hasData": total > 0,
        "totalWorkouts": total,
        "daysSince": None,
        "lastTs": None,
        "lastPlan": None,
        "weekCount": 0,
        "stale": False,
        "staleDays": cfg["staleDays"],
        "lastImport": meta_get(db, "last_import"),
    }
    if not last:
        return out

    dt = to_local(last["ts"])
    out["lastTs"] = last["ts"]
    out["lastPlan"] = last["plan"]
    if dt:
        today = datetime.now(dt.tzinfo).date()
        days = (today - dt.date()).days
        out["daysSince"] = days
        out["stale"] = days >= cfg["staleDays"]

        monday = today - timedelta(days=today.weekday())
        out["weekCount"] = db.execute(
            "SELECT COUNT(*) AS c FROM workouts WHERE ts IS NOT NULL AND date(ts) >= ?",
            (monday.isoformat(),),
        ).fetchone()["c"]
    return out


def build_state(db) -> dict:
    """Reconstruct a merged tp4_state, importable back into GoTrain."""
    scalars = json.loads(meta_get(db, "state_scalars", "{}") or "{}")
    plans = [json.loads(r["json"]) for r in db.execute("SELECT json FROM plans")]
    exercises = [json.loads(r["json"]) for r in db.execute("SELECT json FROM exercises")]

    history = []
    rows = db.execute(
        "SELECT * FROM workouts ORDER BY (ts IS NULL), ts DESC, first_seen DESC"
    ).fetchall()
    for w in rows:
        exs = [
            json.loads(e["json"])
            for e in db.execute(
                "SELECT json FROM workout_exercises WHERE workout_id = ? ORDER BY idx",
                (w["id"],),
            )
        ]
        entry = json.loads(w["json"] or "{}")
        entry["id"] = w["id"]
        entry["exercises"] = exs
        if w["ts"] and "ts" not in entry:
            entry["ts"] = w["ts"]
        history.append(entry)

    return {
        "globalPauseSecs": scalars.get("globalPauseSecs", 75),
        "lang": scalars.get("lang", "en"),
        "activePlanId": scalars.get("activePlanId") or (plans[0]["id"] if plans else None),
        "plans": plans,
        "globalExercises": exercises,
        "progress": scalars.get("progress", {}),
        "history": history,
    }


def report_import(result, label):
    if result["duplicate"]:
        print(f"{label}: already imported, nothing to do")
        return False
    print(f"{label}: {result['new']} new of {result['seen']} workouts")
    return True


def after_import(db, cfg, results):
    total_new = sum(r["new"] for r in results if not r["duplicate"])
    meta_set(db, "last_import", now_iso())
    db.commit()
    prs = [pr for r in results for pr in r.get("prs", [])]
    if total_new:
        body = f"Imported {total_new} workout{'s' if total_new != 1 else ''}"
        if prs:
            named = ", ".join(f"{p['name']} {fmt_load(p['best'], p['unit'])}" for p in prs[:2])
            body += f" · PR: {named}"
            if len(prs) > 2:
                body += f" +{len(prs) - 2} more"
        notify("GoTrain", body)
        for pr in prs:
            print(f"  PR  {pr['name']}: {fmt_load(pr['previous'], pr['unit'])}"
                  f" -> {fmt_load(pr['best'], pr['unit'])}")
    poke_widget()
    return total_new


# ─────────────────────────────────────────────────────────────────────────────
# commands
# ─────────────────────────────────────────────────────────────────────────────

def cmd_import(args, cfg, db):
    results = []
    for p in args.files:
        path = Path(p).expanduser()
        if not path.is_file():
            die(f"no such file: {path}")
        try:
            state, raw = read_state_bytes(path.read_bytes())
            res = ingest(db, state, source=f"file:{path}", raw=raw)
        except (ValueError, json.JSONDecodeError, OSError) as e:
            die(f"{path.name}: {e}")
        report_import(res, path.name)
        results.append(res)
    after_import(db, cfg, results)
    return 0


def find_exports(cfg):
    hits = []
    for d in cfg["watchDirs"]:
        directory = Path(d).expanduser()
        if not directory.is_dir():
            continue
        for pattern in cfg["watchGlobs"]:
            hits.extend(p for p in directory.glob(pattern) if p.is_file())
    return sorted(set(hits), key=lambda p: p.stat().st_mtime, reverse=True)


def cmd_sync(args, cfg, db):
    found = find_exports(cfg)
    if not found:
        dirs = ", ".join(cfg["watchDirs"])
        die(f"no GoTrain export found in {dirs}\n"
            f"       send one from the phone (Settings -> Send to PC) or use "
            f"`{APP} import <file>`")

    targets = found if args.all else found[:1]
    results = []
    for path in targets:
        try:
            state, raw = read_state_bytes(path.read_bytes())
            res = ingest(db, state, source=f"localsend:{path}", raw=raw)
        except (ValueError, json.JSONDecodeError, OSError) as e:
            print(f"{APP}: skipping {path.name}: {e}", file=sys.stderr)
            continue
        report_import(res, path.name)
        results.append(res)
    if not results:
        die("nothing could be imported")
    after_import(db, cfg, results)
    return 0


def cmd_status(args, cfg, db):
    st = compute_status(db, cfg)
    if args.json:
        print(json.dumps(st, ensure_ascii=False))
        return 0
    if not st["hasData"]:
        print("no workouts yet -- run `gotrain sync` after sending data from the phone")
        return 0
    d = st["daysSince"]
    when = "today" if d == 0 else "yesterday" if d == 1 else f"{d} days ago"
    print(f"last workout : {st['lastPlan'] or '?'} ({when})")
    print(f"this week    : {st['weekCount']}")
    print(f"total        : {st['totalWorkouts']}")
    if st["lastImport"]:
        print(f"last import  : {st['lastImport']}")
    return 0


# ─────────────────────────────────────────────────────────────────────────────
# config
#
# Keys the settings tab may edit. Validation lives here rather than in QML so
# the panel, the terminal and any future caller agree on what is legal.
# ─────────────────────────────────────────────────────────────────────────────

EDITABLE = {
    "staleDays":   {"type": "int",  "min": 1,    "max": 365,
                    "label": "Overdue after (days)"},
    "port":        {"type": "int",  "min": 1024, "max": 65535,
                    "label": "Pairing port"},
    "pairTimeout": {"type": "int",  "min": 30,   "max": 3600,
                    "label": "Pairing window (seconds)"},
    "watchDir":    {"type": "path",
                    "label": "Drop folder"},
}


def config_view(cfg) -> dict:
    """Current value of every editable key, plus whether the user set it."""
    try:
        stored = json.loads(CONFIG_PATH.read_text()) if CONFIG_PATH.exists() else {}
    except (OSError, json.JSONDecodeError):
        stored = {}

    out = {}
    for key, spec in EDITABLE.items():
        if key == "watchDir":
            value = (cfg["watchDirs"] or ["~/Downloads"])[0]
            user_set = "watchDirs" in stored
        else:
            value = cfg[key]
            user_set = key in stored
        out[key] = {"value": value, "default": not user_set,
                    "label": spec["label"]}
        for bound in ("min", "max"):
            if bound in spec:
                out[key][bound] = spec[bound]
    return out


def config_set(key: str, raw: str):
    """Validate, then persist only what differs from DEFAULT_CONFIG."""
    spec = EDITABLE.get(key)
    if not spec:
        die(f"unknown setting '{key}'. Editable: {', '.join(sorted(EDITABLE))}")

    if spec["type"] == "int":
        try:
            value = int(str(raw).strip())
        except ValueError:
            die(f"{key} must be a whole number, got '{raw}'")
        lo, hi = spec.get("min"), spec.get("max")
        if lo is not None and value < lo or hi is not None and value > hi:
            die(f"{key} must be between {lo} and {hi}, got {value}")
        store_key, store_value = key, value
    else:
        text = str(raw).strip()
        if not text:
            die(f"{key} cannot be empty")
        # Kept as written (with ~) so the config stays portable; expanded on use.
        if not Path(text).expanduser().is_dir():
            die(f"no such folder: {Path(text).expanduser()}")
        store_key, store_value = "watchDirs", [text]

    try:
        stored = json.loads(CONFIG_PATH.read_text()) if CONFIG_PATH.exists() else {}
    except (OSError, json.JSONDecodeError):
        stored = {}

    if store_value == DEFAULT_CONFIG[store_key]:
        stored.pop(store_key, None)          # back to default: drop the override
    else:
        stored[store_key] = store_value

    CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
    CONFIG_PATH.write_text(json.dumps(stored, indent=2, ensure_ascii=False) + "\n")
    return store_value


def cmd_config(args, cfg, db):
    if args.action == "list":
        view = config_view(cfg)
        if args.json:
            print(json.dumps(view, ensure_ascii=False))
            return 0
        for key, info in view.items():
            origin = "default" if info["default"] else "set"
            print(f"  {key:<14}{str(info['value']):<28}({origin})")
        print(f"\n  file: {CONFIG_PATH}"
              f"{'' if CONFIG_PATH.exists() else '  (not created yet)'}")
        return 0

    if args.action == "get":
        if not args.key:
            die("config get needs a key")
        view = config_view(cfg)
        if args.key not in view:
            die(f"unknown setting '{args.key}'")
        print(view[args.key]["value"])
        return 0

    # set
    if not args.key or args.value is None:
        die("config set needs a key and a value")
    value = config_set(args.key, args.value)
    print(f"{args.key} = {value}")
    poke_widget()
    return 0


def cmd_panel(args, cfg, db):
    """Everything the bar popup renders, in one process call."""
    out = compute_status(db, cfg)

    out["recent"] = [
        {
            "id": w["id"],
            "ts": w["ts"],
            "plan": w["plan"],
            "done": w["done_exercises"],
            "total": w["total_exercises"],
            "sets": w["total_sets"],
        }
        for w in db.execute(
            "SELECT * FROM workouts ORDER BY (ts IS NULL), ts DESC, first_seen DESC "
            "LIMIT ?", (args.number,)
        )
    ]

    # Completed sets per muscle over the trailing 8 weeks -- recent enough to
    # say something about current training, long enough to be stable.
    since = (datetime.now() - timedelta(weeks=8)).date().isoformat()
    grouped = {}
    for r in db.execute(
        "SELECT e.muscle AS muscle, SUM(COALESCE(e.sets_completed, 0)) AS s "
        "FROM workout_exercises e JOIN workouts w ON w.id = e.workout_id "
        "WHERE e.done = 1 AND w.ts IS NOT NULL AND date(w.ts) >= ? "
        "GROUP BY e.muscle", (since,),
    ):
        if not r["s"]:
            continue
        label = muscle_label(r["muscle"]) or "?"
        grouped[label] = grouped.get(label, 0) + r["s"]
    out["muscles"] = [{"muscle": k, "sets": v} for k, v in
                      sorted(grouped.items(), key=lambda kv: -kv[1])[:8]]

    # Trimmed for the popup: the series is capped and the dates dropped, since
    # the tab renders a sparkline and a hover summary, not the full history.
    out["progress"] = [
        {k: v for k, v in row.items() if k != "dates"} | {"series": row["series"][-24:]}
        for row in progression(db)
    ]
    out["config"] = config_view(cfg)
    out["watchDirs"] = [str(Path(d).expanduser()) for d in cfg["watchDirs"]]
    out["pending"] = len(find_exports(cfg))
    out["appUrl"] = cfg["appUrl"]
    print(json.dumps(out, ensure_ascii=False))
    return 0


def cmd_list(args, cfg, db):
    rows = db.execute(
        "SELECT * FROM workouts ORDER BY (ts IS NULL), ts DESC, first_seen DESC LIMIT ?",
        (args.number,),
    ).fetchall()
    if not rows:
        print("no workouts yet")
        return 0
    for w in rows:
        dt = to_local(w["ts"])
        when = dt.strftime("%Y-%m-%d %H:%M") if dt else (w["raw_date"] or "?")
        done = f"{w['done_exercises']}/{w['total_exercises']}"
        print(f"{when}  {done:>7}  {w['plan'] or '?'}   [{w['id']}]")
    return 0


def cmd_show(args, cfg, db):
    w = db.execute("SELECT * FROM workouts WHERE id = ?", (args.id,)).fetchone()
    if not w:
        die(f"no workout with id {args.id}")
    dt = to_local(w["ts"])
    print(f"{w['plan'] or '?'} -- {dt.strftime('%Y-%m-%d %H:%M') if dt else w['raw_date']}")
    print(f"{w['done_exercises']}/{w['total_exercises']} exercises, "
          f"{w['total_sets']} sets\n")
    for e in db.execute(
        "SELECT * FROM workout_exercises WHERE workout_id = ? ORDER BY idx", (args.id,)
    ):
        mark = "x" if e["done"] else " "
        if e["type"] == "time":
            detail = f"{e['duration_min']} min"
        else:
            detail = f"{e['sets_completed'] or 0}/{e['sets'] or 0} sets x {e['reps'] or 0}"
            if e["kg"]:
                detail += f" @ {e['kg']} kg"
        print(f"  [{mark}] {e['name'] or '?':<28} {detail}")
    return 0


def cmd_progress(args, cfg, db):
    rows = progression(db, args.name)
    if not rows:
        if args.json:
            print("[]")
            return 0
        die("no load data yet -- GoTrain records a weight per exercise, so "
            "import a workout that has one")

    if args.json:
        print(json.dumps(rows, ensure_ascii=False))
        return 0

    # A single named exercise gets its full dated series instead of a summary.
    if args.name and len(rows) == 1:
        row = rows[0]
        print(f"{row['name']}  ({row['muscle'] or '?'})\n")
        previous = None
        for when, value in zip(row["dates"], row["series"]):
            mark = ""
            if previous is not None and value != previous:
                mark = f"   {'+' if value > previous else ''}{value - previous:g}"
            print(f"  {when}  {fmt_load(value, row['unit']):>8}{mark}")
            previous = value
        print(f"\n  best {fmt_load(row['best'], row['unit'])}"
              f" · now {fmt_load(row['current'], row['unit'])}"
              f" · {row['sessions']} sessions")
        return 0

    print(f"  {'exercise':<20}{'now':>8}{'best':>8}{'change':>9}   trend")
    for row in rows:
        change = f"{'+' if row['change'] > 0 else ''}{row['change']:g}{row['unit']}"
        star = " *" if row["atBest"] and row["change"] > 0 else ""
        print(f"  {row['name']:<20}{fmt_load(row['current'], row['unit']):>8}"
              f"{fmt_load(row['best'], row['unit']):>8}{change:>9}   "
              f"{spark(row['series'])}{star}")
    print("\n  * at personal best")
    return 0


def cmd_records(args, cfg, db):
    rows = records(db)
    if not rows:
        if args.json:
            print("[]")
            return 0
        die("no load data yet")
    if args.json:
        print(json.dumps(rows, ensure_ascii=False))
        return 0
    for row in rows:
        print(f"  {row['name']:<20}{fmt_load(row['best'], row['unit']):>8}"
              f"   set {row['date']}   {row['muscle']}")
    return 0


def cmd_stats(args, cfg, db):
    total = db.execute("SELECT COUNT(*) AS c FROM workouts").fetchone()["c"]
    if not total:
        print("no workouts yet")
        return 0
    print(f"workouts recorded : {total}")
    span = db.execute(
        "SELECT MIN(ts) AS a, MAX(ts) AS b FROM workouts WHERE ts IS NOT NULL"
    ).fetchone()
    if span["a"]:
        print(f"first / last      : {span['a'][:10]} .. {span['b'][:10]}")
    print("\nby muscle group (completed sets):")
    grouped = {}
    for r in db.execute(
        "SELECT muscle, SUM(COALESCE(sets_completed, 0)) AS s "
        "FROM workout_exercises WHERE done = 1 GROUP BY muscle"
    ):
        if not r["s"]:
            continue
        label = muscle_label(r["muscle"]) or "?"
        grouped[label] = grouped.get(label, 0) + r["s"]
    for label, total in sorted(grouped.items(), key=lambda kv: -kv[1])[:12]:
        print(f"  {label:<20} {total}")
    print("\nmost frequent exercises:")
    for r in db.execute(
        "SELECT name, COUNT(*) AS c FROM workout_exercises WHERE done = 1 "
        "GROUP BY name ORDER BY c DESC LIMIT 10"
    ):
        print(f"  {r['name'] or '?':<28} {r['c']}x")
    return 0


def cmd_export(args, cfg, db):
    state = build_state(db)
    if not state["plans"]:
        die("nothing to export -- no plan library imported yet")
    text = json.dumps(state, indent=2, ensure_ascii=False)
    if args.output:
        out = Path(args.output).expanduser()
        out.write_text(text)
        print(f"wrote {out} ({len(state['history'])} workouts)")
    else:
        print(text)
    return 0


def cmd_doctor(args, cfg, db):
    """Answer "why can't my phone reach this machine" in one screen.

    Written because the first real pairing attempt failed with nothing to go
    on: the phone said "cannot connect" and this side said nothing at all.
    """
    port = cfg["port"]
    problems = []

    def row(label, value, note=""):
        print(f"  {label:<18}{value}" + (f"   {note}" if note else ""))

    ip = lan_ip()
    iface, cidr = iface_for(ip)
    print("network")
    row("interface", iface or "?")
    subnet = cidr.rsplit(".", 1)[0] + ".0/" + cidr.split("/")[1] if cidr else "?"
    row("address", cidr or ip, f"phone must be on {subnet}")
    if ip.startswith("127."):
        problems.append("no LAN address -- this machine is not on a network")
    free = port_is_free(port)
    row(f"port {port}", "free" if free else "IN USE",
        "" if free else "another process holds it")

    print("firewall")
    fw = firewall_status(port)
    if not fw["present"]:
        row("ufw", "not installed", "nothing to configure")
    else:
        state = "active" if (fw["enabled"] and fw["active"]) else "inactive"
        row("ufw", state)
        if state == "active":
            if fw["allowed"]:
                row(f"rule for {port}", "ok")
                for r in fw["rules"][:2]:
                    row("", r)
            elif not fw["checked"]:
                row(f"rule for {port}", "UNKNOWN", "rules not readable")
            else:
                row(f"rule for {port}", "MISSING")
                row("", f"fix: {firewall_fix_command(port)}")
                problems.append(f"ufw blocks port {port}")
    blocks = firewall_blocks(port, minutes=60)
    if blocks:
        who = ", ".join(sorted({b for _, b in blocks}))
        row("blocked recently", f"{len(blocks)} attempt(s) from {who}",
            f"last {blocks[-1][0]}")

    print("tools")
    row("qrencode", "ok" if have("qrencode") else "MISSING (no QR code)")
    if not have("qrencode"):
        problems.append("qrencode is not installed")
    row("omarchy-shell", "ok" if have("omarchy-shell") else "absent (widget will not refresh)")

    print("data")
    total = db.execute("SELECT COUNT(*) AS c FROM workouts").fetchone()["c"]
    row("archive", str(DB_PATH), f"{total} workout(s)")
    for d in cfg["watchDirs"]:
        path = Path(d).expanduser()
        row("watch folder", str(path),
            "missing" if not path.is_dir() else f"{len(find_exports(cfg))} export(s) waiting")

    print()
    if problems:
        for p_ in problems:
            print(f"problem: {p_}", file=sys.stderr)
        return 1
    print("No problems found. Run `gotrain pair` and scan from the app.")
    return 0


# ─────────────────────────────────────────────────────────────────────────────
# pair: one-shot LAN receiver
# ─────────────────────────────────────────────────────────────────────────────

def lan_ip() -> str:
    """Best-guess outward-facing address. Sends nothing -- UDP connect only."""
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        s.connect(("8.8.8.8", 80))
        return s.getsockname()[0]
    except OSError:
        return "127.0.0.1"
    finally:
        s.close()


def iface_for(ip: str):
    """Interface and prefix carrying `ip`, for the doctor's network summary."""
    out = subprocess.run(["ip", "-o", "-4", "addr", "show"],
                         capture_output=True, text=True, check=False).stdout
    for line in out.splitlines():
        parts = line.split()
        if len(parts) >= 4 and parts[3].split("/")[0] == ip:
            return parts[1], parts[3]
    return None, None


def port_is_free(port: int) -> bool:
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    try:
        s.bind(("0.0.0.0", port))
        return True
    except OSError:
        return False
    finally:
        s.close()


def firewall_status(port: int) -> dict:
    """Is ufw going to drop the phone's connection to `port`?

    Every check here reads world-readable state -- no sudo. Omarchy enables ufw
    with `default deny incoming` and opens only 53317 for LocalSend, so a
    custom port is dropped unless something allows it.
    """
    info = {"present": have("ufw"), "enabled": False, "active": False,
            "allowed": False, "rules": [], "checked": False}
    if not info["present"]:
        return info

    conf = Path("/etc/ufw/ufw.conf")
    try:
        info["enabled"] = bool(re.search(r"^ENABLED=yes", conf.read_text(), re.M))
    except OSError:
        pass

    info["active"] = subprocess.run(
        ["systemctl", "is-active", "ufw"], capture_output=True, text=True,
        check=False).stdout.strip() == "active"

    for rules_file in ("/etc/ufw/user.rules", "/etc/ufw/user6.rules"):
        try:
            text = Path(rules_file).read_text()
        except OSError:
            continue
        info["checked"] = True
        for line in text.splitlines():
            # e.g. "### tuple ### allow tcp 8765 0.0.0.0/0 any 0.0.0.0/0 in"
            if line.startswith("### tuple ###") and f" {port} " in line:
                info["rules"].append(line.replace("### tuple ### ", "").strip())
                info["allowed"] = True
    return info


def firewall_blocks(port: int, minutes: int = 60) -> list:
    """Recent ufw drops aimed at `port`, as (time, source-ip) pairs.

    This is what turns "cannot connect" into a named diagnosis: the kernel
    records the phone's own address and the moment it tried.
    """
    try:
        out = subprocess.run(
            ["journalctl", "-k", "--since", f"-{minutes}min", "--no-pager"],
            capture_output=True, text=True, check=False, timeout=15).stdout
    except (OSError, subprocess.SubprocessError):
        return []
    hits = []
    for line in out.splitlines():
        if "UFW BLOCK" not in line or f"DPT={port} " not in line:
            continue
        src = re.search(r"SRC=(\S+)", line)
        when = " ".join(line.split()[:3])
        if src:
            hits.append((when, src.group(1)))
    return hits


def firewall_fix_command(port: int) -> str:
    return f"sudo ufw allow {port}/tcp comment 'gotrain pair'"


def firewall_preflight(port: int, force: bool):
    """Refuse to show a QR code the phone cannot possibly reach."""
    fw = firewall_status(port)
    if not (fw["present"] and fw["enabled"] and fw["active"]):
        return
    if fw["allowed"] or not fw["checked"]:
        return
    if force:
        print(f"{APP}: warning: no ufw rule allows port {port}; "
              f"pairing anyway (--force)\n", file=sys.stderr)
        return
    die(
        f"ufw is active and nothing allows port {port}, so the phone cannot\n"
        f"       reach this machine. Run:\n\n"
        f"           {firewall_fix_command(port)}\n\n"
        f"       then try again.  (--force to pair anyway, "
        f"`{APP} doctor` for detail)"
    )


def print_qr(payload: str):
    if have("qrencode"):
        subprocess.run(["qrencode", "-t", "ANSIUTF8", "-m", "2", payload], check=False)
    else:
        print("(install qrencode to see a scannable code)")
    print(f"\n  {payload}\n")


DONE_PAGE = """<!doctype html><meta charset=utf-8>
<meta name=viewport content="width=device-width,initial-scale=1">
<title>GoTrain</title>
<style>
 body{{font:16px/1.5 system-ui,sans-serif;margin:0;min-height:100vh;display:grid;
      place-items:center;background:#111;color:#eee;text-align:center;padding:2rem}}
 .c{{max-width:22rem}} .t{{font-size:3rem}} a{{color:#7cf}}
</style>
<div class=c><div class=t>{icon}</div><h1>{title}</h1><p>{body}</p>
<p><a href="{app}">Back to GoTrain</a></p></div>
"""


class Receiver(BaseHTTPRequestHandler):
    server_version = "gotrain/1.0"
    # Set by the server factory below.
    token = ""
    cfg: dict = {}
    result: dict = {}
    finished: threading.Event

    # Every request is recorded so a timeout can distinguish "nothing ever
    # reached this machine" (firewall, wrong network) from "it arrived and was
    # rejected". Without this the failure is silent on both ends.
    arrivals: list = []

    def log_message(self, fmt, *args):
        pass                                   # replaced by note() below

    def note(self, status, detail=""):
        stamp = datetime.now().strftime("%H:%M:%S")
        path = self.path.split("?")[0]
        line = f"  {stamp}  {self.command} {path:<8} {status}"
        if detail:
            line += f"  {detail}"
        print(line, file=sys.stderr, flush=True)
        type(self).arrivals.append((status, detail))

    # -- plumbing ----------------------------------------------------------
    def _cors(self):
        self.send_header("Access-Control-Allow-Origin", self.cfg["origin"])
        self.send_header("Access-Control-Allow-Methods", "POST, GET, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "content-type")
        # Legacy Private Network Access; harmless, helps Chrome 104-141.
        self.send_header("Access-Control-Allow-Private-Network", "true")
        self.send_header("Access-Control-Max-Age", "600")

    def _send(self, code, body=b"", ctype="text/plain; charset=utf-8", extra=None):
        if self.command != "OPTIONS":
            self.note(int(code))
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("X-Gotrain", "1")
        self._cors()
        for k, v in (extra or {}).items():
            self.send_header(k, v)
        self.end_headers()
        if body:
            self.wfile.write(body)

    def _page(self, code, icon, title, body):
        html = DONE_PAGE.format(
            icon=icon, title=title, body=body, app=self.cfg["appUrl"]
        ).encode()
        self._send(code, html, "text/html; charset=utf-8")

    def _check_token(self, given: str) -> bool:
        return hmac.compare_digest(given or "", self.token)

    # -- routes ------------------------------------------------------------
    def do_OPTIONS(self):
        self._send(HTTPStatus.NO_CONTENT)

    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        if parsed.path == "/ping":
            self._send(HTTPStatus.OK, b'{"ok":true,"app":"gotrain"}',
                       "application/json")
            return
        if parsed.path == "/recv":
            q = urllib.parse.parse_qs(parsed.query)
            if not self._check_token(q.get("t", [""])[0]):
                self._page(HTTPStatus.FORBIDDEN, "✕", "Wrong code",
                           "That pairing code is not valid. Start "
                           "<code>gotrain pair</code> again.")
                return
            data = q.get("d", [""])[0]
            kind = q.get("c", ["full"])[0]
            self._ingest_payload(data.encode(), kind, "pair:url", html=True)
            return
        self._send(HTTPStatus.NOT_FOUND, b"not found")

    def do_POST(self):
        parsed = urllib.parse.urlparse(self.path)
        if not parsed.path.startswith("/recv"):
            self._send(HTTPStatus.NOT_FOUND, b"not found")
            return
        token = parsed.path[len("/recv/"):] if parsed.path.startswith("/recv/") else ""
        if not token:
            token = urllib.parse.parse_qs(parsed.query).get("t", [""])[0]
        if not self._check_token(token):
            self._send(HTTPStatus.FORBIDDEN, b'{"error":"bad token"}',
                       "application/json")
            return
        try:
            length = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            length = 0
        if length <= 0 or length > 32 * 1024 * 1024:
            self._send(HTTPStatus.BAD_REQUEST, b'{"error":"bad length"}',
                       "application/json")
            return
        kind = urllib.parse.parse_qs(parsed.query).get("c", ["full"])[0]
        self._ingest_payload(self.rfile.read(length), kind, "pair:post", html=False,
                             already_binary=True)

    # -- ingest ------------------------------------------------------------
    def _ingest_payload(self, payload: bytes, kind: str, source: str,
                        *, html: bool, already_binary: bool = False):
        kind = "delta" if kind == "delta" else "full"
        try:
            raw = payload if already_binary else b64url_decode(payload)
            state, raw = read_state_bytes(raw)
        except Exception as e:                       # noqa: BLE001 - report anything
            self._fail(html, f"Could not read the transfer ({e}).")
            return

        db = connect()
        try:
            res = ingest(db, state, source=source, kind=kind, raw=raw)
            meta_set(db, "last_import", now_iso())
            db.commit()
        except ValueError as e:
            self._fail(html, str(e))
            db.close()
            return
        db.close()

        self.result.update(res)
        if html:
            n = res["new"]
            self._page(
                HTTPStatus.OK, "✓", "Synced",
                "Nothing new to add." if res["duplicate"] or not n
                else f"{n} workout{'s' if n != 1 else ''} added on your PC.",
            )
        else:
            self._send(HTTPStatus.OK,
                       json.dumps({"ok": True, **res}).encode(), "application/json")
        self.finished.set()

    def _fail(self, html: bool, msg: str):
        if html:
            self._page(HTTPStatus.BAD_REQUEST, "✕", "Sync failed", msg)
        else:
            self._send(HTTPStatus.BAD_REQUEST,
                       json.dumps({"ok": False, "error": msg}).encode(),
                       "application/json")


class PairServer(ThreadingHTTPServer):
    """ThreadingHTTPServer without the reverse-DNS stall.

    HTTPServer.server_bind() calls socket.getfqdn(), which blocks for about
    five seconds whenever the resolver can't answer -- five seconds of blank
    terminal before the QR code appears. Nothing here reads server_name.
    """

    daemon_threads = True

    def server_bind(self):
        socketserver.TCPServer.server_bind(self)
        self.server_name = "gotrain"
        self.server_port = self.server_address[1]


def b64url_decode(data: bytes) -> bytes:
    import base64
    s = data.decode("ascii", "strict").strip()
    s = urllib.parse.unquote(s)
    pad = "=" * (-len(s) % 4)
    return base64.urlsafe_b64decode(s + pad)


def cmd_pair(args, cfg, db):
    port = args.port or cfg["port"]
    firewall_preflight(port, args.force)
    token = secrets.token_urlsafe(16)
    ip = lan_ip()
    cursor = meta_get(db, "cursor_ts", "") or ""
    phash = meta_get(db, "plan_hash", "") or ""
    db.close()

    finished = threading.Event()

    handler = type("BoundReceiver", (Receiver,), {
        "token": token, "cfg": cfg, "result": {}, "finished": finished,
        "arrivals": [],
    })

    try:
        httpd = PairServer(("0.0.0.0", port), handler)
    except OSError as e:
        die(f"cannot listen on port {port}: {e}")

    payload = f"gotrain1:{ip}:{port}:{token}:{cursor}:{phash}"

    print("Scan this from inside GoTrain (Settings -> Scan PC code):\n")
    print_qr(payload)
    if cursor:
        print(f"Only workouts newer than {cursor[:16]} will be sent.")
    else:
        print("First sync: the phone will send everything.")
    # Explicit flush: stdout is block-buffered when piped, and this command
    # prints something to look at and then blocks.
    mins, secs = divmod(int(cfg["pairTimeout"]), 60)
    print(f"Listening on http://{ip}:{port} for up to {mins}:{secs:02d} "
          f"-- Ctrl-C to stop.\n", flush=True)

    thread = threading.Thread(target=httpd.serve_forever, daemon=True)
    thread.start()

    timeout = cfg["pairTimeout"]
    try:
        if not finished.wait(timeout):
            httpd.shutdown()
            # Which of the two failures happened is the whole diagnosis, and
            # it is exactly what the receiver used to swallow.
            if not handler.arrivals:
                print(f"\nTimed out after {timeout}s -- no connection attempt "
                      f"reached this machine.", file=sys.stderr)
                blocks = firewall_blocks(port, minutes=10)
                if blocks:
                    who = ", ".join(sorted({ip for _, ip in blocks}))
                    print(f"The firewall dropped {len(blocks)} attempt(s) from "
                          f"{who}. Run:\n\n    {firewall_fix_command(port)}\n",
                          file=sys.stderr)
                else:
                    print(f"Check that the phone is on the same network as "
                          f"{ip}, then run `{APP} doctor`.", file=sys.stderr)
            else:
                last = handler.arrivals[-1]
                print(f"\nTimed out after {timeout}s. A request arrived but did "
                      f"not complete (last: {last[0]}"
                      f"{' ' + last[1] if last[1] else ''}).\n"
                      f"If it was rejected, rescan for a fresh code -- each "
                      f"pairing code works once.", file=sys.stderr)
            return 1
    except KeyboardInterrupt:
        print("\nCancelled.")
        httpd.shutdown()
        return 130

    httpd.shutdown()
    res = handler.result
    if res.get("duplicate"):
        print("Already had that data -- nothing new.")
    else:
        n = res.get("new", 0)
        print(f"Received {n} new workout{'s' if n != 1 else ''}.")
        if n:
            notify("GoTrain", f"Imported {n} workout{'s' if n != 1 else ''}")
    poke_widget()
    return 0


# ─────────────────────────────────────────────────────────────────────────────
# entry point
# ─────────────────────────────────────────────────────────────────────────────

def main(argv=None):
    parser = argparse.ArgumentParser(
        prog=APP, description="Sync GoTrain workout data to this machine.")
    sub = parser.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("sync", help="import the newest export from the watch folders")
    p.add_argument("--all", action="store_true",
                   help="import every matching export, not just the newest")
    p.set_defaults(fn=cmd_sync)

    p = sub.add_parser("import", help="import specific export file(s)")
    p.add_argument("files", nargs="+")
    p.set_defaults(fn=cmd_import)

    p = sub.add_parser("pair", help="show a QR code and receive one transfer")
    p.add_argument("--port", type=int)
    p.add_argument("--force", action="store_true",
                   help="pair even if no firewall rule allows the port")
    p.set_defaults(fn=cmd_pair)

    p = sub.add_parser("doctor", help="check why the phone cannot reach this machine")
    p.set_defaults(fn=cmd_doctor)

    p = sub.add_parser("config", help="show or change settings")
    p.add_argument("action", choices=["list", "get", "set"], nargs="?", default="list")
    p.add_argument("key", nargs="?")
    p.add_argument("value", nargs="?")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_config)

    p = sub.add_parser("status", help="summary (the bar widget reads --json)")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_status)

    p = sub.add_parser("panel", help="JSON for the bar popup (internal)")
    p.add_argument("-n", "--number", type=int, default=8)
    p.set_defaults(fn=cmd_panel)

    p = sub.add_parser("progress", help="how the load on each exercise has moved")
    p.add_argument("name", nargs="?", help="one exercise, for its full series")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_progress)

    p = sub.add_parser("records", help="best ever load per exercise")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_records)

    p = sub.add_parser("list", help="recent workouts")
    p.add_argument("-n", "--number", type=int, default=15)
    p.set_defaults(fn=cmd_list)

    p = sub.add_parser("show", help="one workout in detail")
    p.add_argument("id")
    p.set_defaults(fn=cmd_show)

    p = sub.add_parser("stats", help="aggregate statistics")
    p.set_defaults(fn=cmd_stats)

    p = sub.add_parser("export", help="write a merged tp4_state for GoTrain to import")
    p.add_argument("-o", "--output")
    p.set_defaults(fn=cmd_export)

    args = parser.parse_args(argv)
    cfg = load_config()
    db = connect()
    try:
        return args.fn(args, cfg, db)
    finally:
        try:
            db.close()
        except sqlite3.ProgrammingError:
            pass


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        raise SystemExit(130)
